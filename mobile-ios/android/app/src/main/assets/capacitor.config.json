{
	"appId": "vn.chioi.tasker",
	"appName": "Chị Ơi Tasker",
	"webDir": "www",
	"server": {
		"url": "https://app.chioi.vn/giupviec/trangchutasker.html",
		"cleartext": false,
		"allowNavigation": [
			"app.chioi.vn",
			"chioi.vn",
			"api.chioi.vn",
			"*.chioi.vn"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#a04100",
			"showSpinner": true,
			"spinnerColor": "#ffffff",
			"androidScaleType": "CENTER_CROP"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
